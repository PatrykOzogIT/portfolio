# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-error.log
.npm/

# Angular
/.angular/

# Generated content and responsive image variants (npm run content)
/src/content/generated/
/.image-cache/

# Tests
/coverage
/test-results/
/playwright-report/
__screenshots__/

# Environment and secrets — never commit credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Private documents — the CV is deliberately not published with the site
/public/cv/
*.pdf

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
desktop.ini

# Local tooling (Claude Code)
/.claude/
