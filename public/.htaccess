# ============================================================================
# patryk-ozog.pl — Apache configuration for the prerendered (static) site.
# Copied to the build root by angular.json (public/). Every block is guarded
# with <IfModule>, so a missing module never breaks the site.
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

# Canonical URLs have no trailing slash (/pl, /pl/projects/x) and point to
# directories with an index.html. Apache must not add a slash itself.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. One canonical origin: https://patryk-ozog.pl (no www) ------------
  # X-Forwarded-Proto: if TLS ends at a proxy in front of Apache, %{HTTPS} is
  # off even for HTTPS visitors — without this check the redirect would loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://patryk-ozog.pl%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://patryk-ozog.pl%{REQUEST_URI} [R=301,L,NE]

  # --- 2. Root → language version (browser language; Polish by default) ----
  RewriteCond %{HTTP:Accept-Language} ^(?!pl). [NC]
  RewriteCond %{HTTP:Accept-Language} .
  RewriteRule ^$ /en [R=302,L]
  RewriteRule ^$ /pl [R=302,L]

  # --- 3. Remove trailing slashes: /pl/ → /pl ------------------------------
  RewriteCond %{REQUEST_URI} ^/.+/$
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # --- 4. Clean URLs: /pl/projects/x → /pl/projects/x/index.html ------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# --- 404 pages in the visitor's language ------------------------------------
ErrorDocument 404 /pl/not-found/index.html
<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
  ErrorDocument 404 /en/not-found/index.html
</If>

# --- Types -------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .xml .txt .json .svg
  <FilesMatch "^LICENSE$">
    ForceType "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

# --- Compression (Brotli when available, gzip otherwise) ---------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# --- Caching -----------------------------------------------------------------
# HTML always revalidates (new deploys are visible at once); fingerprinted
# bundles, fonts and generated image variants never change → cache for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(png|jpe?g|svg|ico|txt|xml)$">
    Header setifempty Cache-Control "public, max-age=86400"
  </FilesMatch>

  # --- Security headers ------------------------------------------------------
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
  Header always set X-Frame-Options "DENY"

  # The root redirect depends on the browser language.
  <If "%{REQUEST_URI} == '/'">
    Header always merge Vary "Accept-Language"
  </If>
</IfModule>

# --- Never serve build leftovers or dotfiles ----------------------------------
<FilesMatch "^(\.|index\.csr\.html$)">
  Require all denied
</FilesMatch>
