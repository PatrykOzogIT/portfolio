{
  "name": "portfolio",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "ng": "ng",
    "content": "tsx scripts/content.ts",
    "start": "npm run content && ng serve",
    "build": "npm run content && ng build && tsx scripts/postbuild.ts",
    "preview": "node scripts/serve-static.mjs dist/portfolio/browser 4400",
    "test": "npm run content && ng test --watch=false",
    "test:watch": "npm run content && ng test",
    "test:scripts": "tsx --test \"scripts/**/*.test.ts\"",
    "typecheck": "npm run content && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "marked": "^18.1.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
